data "aws_ami" "ubuntu-ami" {
    most_recent = true
    owners = ["099720109477"]
    filter {
        name = "name"
        values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-20250115"]
    }
}

data "external" "user_infos" {
  program = [ "bash", "scripts/user_infos.sh" ]
}

resource "aws_instance" "my_ec2_instance" {
    # Using the aws key for ssh connection
    key_name = aws_key_pair.my_ec2.key_name

    # Use AMI declared in var file
    #ami = var.AWS_AMIS[var.AWS_REGION]

    # Use AMI from data source
    ami = data.aws_ami.ubuntu-ami.id


    # Use VPC retrieved when sg is created
    vpc_security_group_ids = [aws_security_group.instance_sg.id]
    instance_type = "t3.micro"
    connection {
      type = "ssh"
      user = "ubuntu"
      # Use private key generated by tls terraform provider
      private_key = tls_private_key.terraform_ssh_key.private_key_openssh
      host = self.public_ip
    }

    provisioner "remote-exec" {
      inline = [
          "sudo apt-get -f -y update",
          "sudo apt-get install -f -y apache2",
          "sudo systemctl start apache2",
          "sudo systemctl enable apache2",
          "sudo sh -c 'echo \"<h1>Hello devopssec</h1>\" > /var/www/html/index.html'",
      ]
    }
    ### USING remote-exec instead ###
    #
    # user_data = <<-EOF
    #   #!/bin/bash
    #   sudo apt-get update
    #   sudo apt-get install -y apache2
    #   sudo systemctl start apache2
    #   sudo systemctl enable apache2
    #   sudo echo "<h1>Hello devopssec !</h1>" > /var/www/html/index.html
    # EOF
    tags = {
        Name = "${terraform.workspace}-${data.external.user_infos.result.user}-${data.external.user_infos.result.commit}-ec2"
    }  
}

output "public_ip" {
    value = aws_instance.my_ec2_instance.public_ip
}
